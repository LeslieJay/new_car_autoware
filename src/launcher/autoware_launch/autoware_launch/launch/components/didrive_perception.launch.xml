<launch>
  <arg name="base_frame" default="base_link" description="base frame"/>
  <arg name="use_sim_time" default="true" description="use simulator time"/>
  <arg name="pointcloud_container_name" default="perception_container" description="name of pointcloud container"/>
  <arg name="use_pointcloud_container" default="true"/>
  <arg name="enable_lane_detection" default="false" description="Enable lane detection module"/>
  <!-- <arg name="use_detection_by_tracker" default="false" description="enable detection_by_tracker module"/> -->
  <arg name="use_detection_by_tracker" default="true" description="enable detection_by_tracker module"/>
  <arg name="pointcloud" default="/sensing/lidar/concatenated/pointcloud" description="use simulator time"/>
  <arg name="occupancy_grid_map_method" default="pointcloud_based_occupancy_grid_map" description="options: pointcloud_based_occupancy_grid_map, laserscan_based_occupancy_grid_map, multi_lidar_pointcloud_based_occupancy_grid_map"/>
  <arg name="occupancy_grid_map_updater" default="binary_bayes_filter" description="options: binary_bayes_filter"/>
  <arg name="occupancy_grid_map_param_path" default="$(find-pkg-share autoware_launch)/config/perception/occupancy_grid_map/$(var occupancy_grid_map_method).param.yaml"/>
  <arg name="occupancy_grid_map_updater_param_path" default="$(find-pkg-share autoware_launch)/config/perception/occupancy_grid_map/$(var occupancy_grid_map_updater)_updater.param.yaml"/>
  <arg name="use_vector_map_filter" default="true" description="enable vector map inside area filter"/>
  <arg name="input_vector_map" default="/map/vector_map" description="vector map topic"/>
  <arg name="use_object_class_remapper" default="true" description="enable object classification remapping to UNKNOWN, CAR, PEDESTRIAN"/>
  <arg name="enable_pointcloud_box_clamper" default="false" description="enable point cloud bounding box clamping for oversized vehicles"/>
  
  <!--   
  启动相机ros节点 
  <include file="$(find-pkg-share v4l2_camera)/launch/v4l2_camera.launch.xml">
    <arg name="undistort_enabled" value="true"/>
    <arg name="publish_rate" value="10.0"/>
  </include>
  -->

  <!-- Perception module -->
  <group>
    <push-ros-namespace namespace="perception"/>
    <group>
      <!-- ground segmentation -->
      <push-ros-namespace namespace="obstacle_segmentation"/>

      <let name="ground_filter_output" value="/perception/obstacle_segmentation/raw_pointcloud" if="$(var use_vector_map_filter)"/>
      <let name="ground_filter_output" value="/perception/obstacle_segmentation/pointcloud" unless="$(var use_vector_map_filter)"/>

      <!-- ray_ground_filter -->
      <include file="$(find-pkg-share autoware_ground_segmentation)/launch/ray_ground_filter.launch.xml">
        <arg name="input/pointcloud" value="$(var pointcloud)"/>
        <arg name="output/pointcloud" value="$(var ground_filter_output)"/>
      </include>

      <!-- vector_map_inside_area_filter -->
      <group if="$(var use_vector_map_filter)">
        <include file="$(find-pkg-share autoware_pointcloud_preprocessor)/launch/vector_map_inside_area_filter_node.launch.xml">
          <arg name="use_sim_time" value="$(var use_sim_time)"/>
          <arg name="input_vector_map" value="$(var input_vector_map)"/>
          <arg name="input_pointcloud" value="$(var ground_filter_output)"/>
          <arg name="output_pointcloud" value="/perception/obstacle_segmentation/pointcloud"/>
        </include>
      </group>

      <!-- original patchworkpp (commented out)
      <include file="$(find-pkg-share didrive_patchwork)/launch/patchworkpp.launch.py">
        <arg name="base_frame" value="$(var base_frame)"/>
        <arg name="input_pointcloud" value="$(var pointcloud)"/>
        <arg name="use_mask" value="false"/>
        <arg name="use_pointcloud_container" value="$(var use_pointcloud_container)"/>
        <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
        <arg name="output_ground" value="/perception/obstacle_segmentation/ground"/>
        <arg name="output_nonground" value="$(var ground_filter_output)"/>
        <arg name="visualize" value="false"/>
      </include>
      -->
    </group>

    <!-- 
    lane detection
    <group>
      <push-ros-namespace namespace="lane_detection"/>
      <include file="$(find-pkg-share didrive_ufld_ros)/launch/ufld.launch.py"
              if="$(var enable_lane_detection)">
        <arg name="output_topic" value="/perception/lane_detection/points"/>
      </include>
    </group>
     -->

    <!-- Occupancy grid map module -->
    <group>
      <push-ros-namespace namespace="occupancy_grid_map"/>
      <include file="$(find-pkg-share autoware_launch)/launch/components/didrive_probabilistic_occupancy_grid_map.launch.xml">
        <arg name="input/obstacle_pointcloud" value="/perception/obstacle_segmentation/pointcloud"/>
        <arg name="input/raw_pointcloud" value="$(var pointcloud)"/>
        <arg name="output" value="/perception/occupancy_grid_map/map"/>
        <arg name="use_pointcloud_container" value="$(var use_pointcloud_container)"/>
        <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
        <arg name="occupancy_grid_map_method" value="$(var occupancy_grid_map_method)"/>
        <arg name="occupancy_grid_map_param_path" value="$(var occupancy_grid_map_param_path)"/>
        <arg name="occupancy_grid_map_updater" value="$(var occupancy_grid_map_updater)"/>
        <arg name="occupancy_grid_map_updater_param_path" value="$(var occupancy_grid_map_updater_param_path)"/>
      </include>
    </group>
    
    <!-- Object recogniton module -->
    <group>
      <push-ros-namespace namespace="object_recognition"/>
      <!-- Detection module -->
      <group>
        <push-ros-namespace namespace="detection"/>
        <!-- original didrive_euclidean_cluster (commented out)
        <group>
          <include file="$(find-pkg-share didrive_euclidean_cluster)/launch/voxel_grid_based_euclidean_cluster.launch.py">
            <arg name="use_pointcloud_container" value="$(var use_pointcloud_container)"/>
            <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
            <arg name="input_pointcloud" value="/perception/obstacle_segmentation/pointcloud"/>
            <arg name="output_clusters" value="/perception/object_recognition/detection/lidar_rule/objects"/>
          </include>
        </group>
        -->

        <!-- autoware_euclidean_cluster (outputs clusters with pointcloud feature) -->
        <group>
          <include file="$(find-pkg-share autoware_euclidean_cluster)/launch/voxel_grid_based_euclidean_cluster.launch.xml">
            <arg name="input_pointcloud" value="/perception/obstacle_segmentation/pointcloud"/>
            <arg name="output_clusters" value="/perception/object_recognition/detection/clustering/clusters_with_feature"/>
            <arg name="use_low_height_cropbox" value="false"/>
            <arg name="use_pointcloud_container" value="$(var use_pointcloud_container)"/>
            <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
          </include>
        </group>

        <!-- autoware_shape_estimation (estimates 3D bounding box / polygon shape from clusters) -->
        <group>
          <include file="$(find-pkg-share autoware_shape_estimation)/launch/shape_estimation.launch.xml">
            <arg name="input/objects" value="/perception/object_recognition/detection/clustering/clusters_with_feature"/>
            <arg name="output/objects" value="/perception/object_recognition/detection/clustering/objects_with_feature"/>
          </include>
        </group>

        <!-- autoware_detected_object_feature_remover (converts DetectedObjectsWithFeature to DetectedObjects for merger) -->
        <group>
          <include file="$(find-pkg-share autoware_detected_object_feature_remover)/launch/detected_object_feature_remover.launch.xml">
            <arg name="input" value="/perception/object_recognition/detection/clustering/objects_with_feature"/>
            <arg name="output" value="/perception/object_recognition/detection/lidar_rule/objects"/>
          </include>
        </group>

        <!-- original detection_by_tracker (commented out)
        <group if="$(var use_detection_by_tracker)">
          <include file="$(find-pkg-share autoware_detection_by_tracker)/launch/detection_by_tracker.launch.xml">
            <arg name="input/initial_objects" value="/perception/object_recognition/detection/lidar_rule/objects"/>
            <arg name="input/tracked_objects" value="/perception/object_recognition/tracking/objects"/>
            <arg name="output" value="/perception/object_recognition/detection/detection_by_tracker/objects"/>
          </include>
        </group>
        -->

        <!-- autoware_detection_by_tracker (takes objects_with_feature and tracked_objects) -->
        <group if="$(var use_detection_by_tracker)">
          <include file="$(find-pkg-share autoware_detection_by_tracker)/launch/detection_by_tracker.launch.xml">
            <arg name="input/initial_objects" value="/perception/object_recognition/detection/clustering/objects_with_feature"/>
            <arg name="input/tracked_objects" value="/perception/object_recognition/tracking/objects"/>
            <arg name="output" value="/perception/object_recognition/detection/detection_by_tracker/objects"/>
          </include>
        </group>

        <!--         
        bevfusion
        <group>
          <include file="$(find-pkg-share didrive_ros2_bevfusion_async)/launch/bevfusion.launch.py">
            <arg name="model_path" value="$(find-pkg-share didrive_ros2_bevfusion_async)/models/resnet50_v1/onnx_int8"/>
            <arg name="precision" value="int8"/>
            <arg name="use_pointcloud_container" value="$(var use_pointcloud_container)"/>
            <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
            <arg name="lidar_topic" value="/perception/obstacle_segmentation/pointcloud"/>
            <arg name="detection_topic" value="/perception/object_recognition/detection/lidar_dnn/objects"/>
          </include>
        </group> -->

        <!-- centerpoint (commented out) -->
        <group>
          <include file="$(find-pkg-share autoware_lidar_centerpoint)/launch/lidar_centerpoint.launch.xml">
            <!-- <arg name="input/pointcloud" value="/perception/obstacle_segmentation/pointcloud"/> -->
            <arg name="input/pointcloud" value="$(var pointcloud)"/>
            <arg name="output/objects" value="/perception/object_recognition/detection/lidar_dnn/objects"/>
            <arg name="model_name" value="centerpoint"/>
            <!-- <arg name="model_path" value="$(env HOME)/autoware_data/lidar_centerpoint"/> -->
            <arg name="model_path" value="$(env HOME)/autoware_data/lidar_centerpoint/sigma"/>  <!-- 这里末尾加上 /base -->
            <arg name="use_pointcloud_container" value="$(var use_pointcloud_container)"/>
            <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
          </include>
        </group>
       
       
        <!-- ==================== Plan B: Cascaded Detection Mergers ==================== -->
        <!-- 1st merger: lidar_rule + lidar_dnn (Confidence mode) -->
        <let name="merger1_output_object" value="/perception/object_recognition/detection/temporary_merged_objects" if="$(var use_detection_by_tracker)"/>
        <let name="merger1_output_object" value="/perception/object_recognition/detection/merged/objects" unless="$(var use_detection_by_tracker)"/>

        <group>
          <!-- 1st merger: object_association_merger_alpha -->
          <include file="$(find-pkg-share didrive_object_merger)/launch/object_association_merger.launch.xml">
            <arg name="input/object0" value="/perception/object_recognition/detection/lidar_rule/objects"/>
            <arg name="input/object1" value="/perception/object_recognition/detection/lidar_dnn/objects"/>
            <arg name="output/object" value="$(var merger1_output_object)"/>
            <arg name="base_link_frame_id" value="$(var base_frame)"/>
            <arg name="priority_mode" value="2"/>
          </include>
        </group>

        <!-- 2nd merger: temporary_merged_objects + detection_by_tracker (Object1 mode: DBT wins) -->
        <group if="$(var use_detection_by_tracker)">
          <include file="$(find-pkg-share didrive_object_merger)/launch/object_association_merger.launch.xml">
            <arg name="input/object0" value="/perception/object_recognition/detection/temporary_merged_objects"/>
            <arg name="input/object1" value="/perception/object_recognition/detection/detection_by_tracker/objects"/>
            <arg name="output/object" value="/perception/object_recognition/detection/merged/objects"/>
            <arg name="base_link_frame_id" value="$(var base_frame)"/>
            <arg name="priority_mode" value="1"/>
          </include>
        </group>
       

        <!-- original object validation (commented out)
        <group>
          <include file="$(find-pkg-share didrive_detected_object_validation)/launch/object_lanelet_filter.launch.xml">
            <arg name="input/object" value="/perception/object_recognition/detection/merged/objects"/>
            <arg name="output/object" value="/perception/object_recognition/detection/objects"/>
          </include>
        </group>
        -->

        <group>
          <!-- object validation (lanelet filter) -->
          <let name="lanelet_output_object" value="/perception/object_recognition/detection/lanelet_filtered/objects" if="$(var enable_pointcloud_box_clamper)"/>
          <let name="lanelet_output_object" value="/perception/object_recognition/detection/objects" unless="$(var enable_pointcloud_box_clamper)"/>

          <include file="$(find-pkg-share didrive_detected_object_validation)/launch/object_lanelet_filter.launch.xml">
            <arg name="input/object" value="/perception/object_recognition/detection/merged/objects"/>
            <!-- <arg name="input/object" value="/perception/object_recognition/detection/lidar_dnn/objects"/> -->
            <arg name="output/object" value="$(var lanelet_output_object)"/>
          </include>
        </group>

        <!-- pointcloud bounding box clamper (scheme 2) -->
        <group if="$(var enable_pointcloud_box_clamper)">
          <include file="$(find-pkg-share didrive_pointcloud_box_clamper)/launch/pointcloud_box_clamper.launch.xml">
            <arg name="input/object" value="/perception/object_recognition/detection/lanelet_filtered/objects"/>
            <!-- <arg name="input/pointcloud" value="/perception/obstacle_segmentation/pointcloud"/> -->
            <arg name="input/pointcloud" value="$(var pointcloud)"/>
            <arg name="input/rule_objects" value="/perception/object_recognition/detection/lidar_rule/objects"/>
            <arg name="output/object" value="/perception/object_recognition/detection/objects"/>
          </include>
        </group>
      </group>
      
      <!-- tracking module -->
      <group>
        <push-ros-namespace namespace="tracking"/>
        <!-- original tracker (didrive_multi_object_tracker) - commented out
        <include file="$(find-pkg-share didrive_multi_object_tracker)/launch/multi_object_tracker.launch.xml">
          <arg name="output" value="/perception/object_recognition/tracking/objects"/>
        </include>
        -->

        <!-- autoware_multi_object_tracker multi-channel configuration (commented out for Plan B)
        <let name="input/detection02/channel" value="detection_by_tracker" if="$(var use_detection_by_tracker)"/>
        <let name="input/detection02/channel" value="none" unless="$(var use_detection_by_tracker)"/>
        <let name="input/detection02/objects" value="/perception/object_recognition/detection/detection_by_tracker/objects" if="$(var use_detection_by_tracker)"/>
        <let name="input/detection02/objects" value="input/objects02" unless="$(var use_detection_by_tracker)"/>

        <include file="$(find-pkg-share autoware_multi_object_tracker)/launch/multi_object_tracker.launch.xml">
          <arg name="input/detection01/channel" value="lidar_centerpoint"/>
          <arg name="input/detection01/objects" value="/perception/object_recognition/detection/objects"/>
          <arg name="input/detection02/channel" value="$(var input/detection02/channel)"/>
          <arg name="input/detection02/objects" value="$(var input/detection02/objects)"/>
          <arg name="output/objects" value="/perception/object_recognition/tracking/objects"/>
        </include>
        -->

        <!-- single channel tracker receiving merged detection objects (Plan B) -->
        <include file="$(find-pkg-share autoware_multi_object_tracker)/launch/multi_object_tracker.launch.xml">
          <arg name="input/detection01/channel" value="detected_objects"/>
          <arg name="input/detection01/objects" value="/perception/object_recognition/detection/objects"/>
          <arg name="output/objects" value="/perception/object_recognition/tracking/objects"/>
        </include>
      </group>
      
      <!-- Prediction module -->
      <group>
        <push-ros-namespace namespace="prediction"/>

        <let name="prediction_output" value="/perception/object_recognition/prediction/objects" if="$(var use_object_class_remapper)"/>
        <let name="prediction_output" value="/perception/object_recognition/objects" unless="$(var use_object_class_remapper)"/>

        <!-- prediction -->
        <include file="$(find-pkg-share didrive_map_based_prediction)/launch/map_based_prediction.launch.xml">
          <arg name="input_topic" value="/perception/object_recognition/tracking/objects"/>
          <arg name="output_topic" value="$(var prediction_output)"/>
        </include>

        <!-- object class remapper -->
        <group if="$(var use_object_class_remapper)">
          <include file="$(find-pkg-share didrive_object_class_remapper)/launch/object_class_remapper.launch.xml">
            <arg name="input_topic" value="$(var prediction_output)"/>
            <arg name="output_topic" value="/perception/object_recognition/objects"/>
          </include>
        </group>
      </group>
    </group>
  </group>
  
</launch>
